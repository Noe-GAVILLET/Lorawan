
# --- InfluxDB ---
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change_me
INFLUX_ORG=hive-org
INFLUX_BUCKET=hive
INFLUX_TOKEN=change_me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Publisher ---
# Intervalle de publication en secondes
PUBLISH_INTERVAL_SECONDS=600

# Mode de simulation : normal | extreme
# - normal  : marche aléatoire dans les bornes physiques
# - extreme : injection périodique de spikes (pour tester H2)
SCENARIO=normal
