@startuml
!theme plain
skinparam backgroundColor #FAFBFC
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false

skinparam rectangle {
    RoundCorner 10
    BorderThickness 2
}

title
<color:#1B3A5C><size:16><b>Figure 3 — Structure d'une Trame LoRaWAN (Uplink Classe A)</b></size></color>
<color:#4A4A4A><size:10><i>Décomposition PHYPayload · Double couche AES-128</i></size></color>
end title

' ── Niveau 1 : PHYPayload ────────────────────────────────────────────
package "PHYPayload  <i>(trame radio complète)</i>" as PHY <<Rectangle>> #EEF2F7 {

    rectangle "**MHDR**\n──────\n1 octet\nMType\n(Unconfirmed\nData Up)" as MHDR #1B3A5C
    rectangle "**MACPayload**\n──────────────\nFHDR + FPort\n+ FRMPayload\n<i>(voir ci-dessous)</i>" as MACPAY #2E6DA4
    rectangle "**MIC**\n──────\n4 octets\nAES-128\nCMAC\n(NwkSKey)" as MIC #8E1A1A

}

MHDR -right-> MACPAY
MACPAY -right-> MIC

' ── Niveau 2 : MACPayload ────────────────────────────────────────────
package "MACPayload  <i>(décomposition)</i>" as MACL <<Rectangle>> #F5F7FA {

    package "FHDR  <i>(7–22 octets)</i>" as FHDR_PKG #EEF2F7 {
        rectangle "**DevAddr**\n4 octets\nAdresse\nréseau" as DEVADDR #1B3A5C
        rectangle "**FCtrl**\n1 octet\nADR · ACK\nFOptsLen" as FCTRL #1B3A5C
        rectangle "**FCnt**\n2 octets\nCompteur\nanti-rejeu" as FCNT #C0392B
        rectangle "**FOpts**\n0–15 oct.\nCommandes\nMAC" as FOPTS #4A4A4A
    }

    rectangle "**FPort**\n1 octet\n(opt.)\nApp ID" as FPORT #2E6DA4
    rectangle "**FRMPayload**\n≤ 51 octets\n<i>AES-128 CTR</i>\n(AppSKey)\njson chiffré" as FRMPAY #1A6B3A

}

DEVADDR -right-> FCTRL
FCTRL   -right-> FCNT
FCNT    -right-> FOPTS
FOPTS   -right-> FPORT
FPORT   -right-> FRMPAY

' ── Niveau 3 : FRMPayload déchiffré ─────────────────────────────────
package "FRMPayload déchiffré  <i>(données applicatives)</i>" as APP <<Rectangle>> #F0FFF4 {
    rectangle "**temperature**\nfloat 32b\nex: 34.47 °C" as F1 #1A6B3A
    rectangle "**mass**\nfloat 32b\nex: 43.21 kg" as F2 #1A6B3A
    rectangle "**scenario**\nstring\nnominal|\nextreme" as F3 #1A6B3A
    rectangle "**battery_v**\nfloat 32b\nex: 4.09 V" as F4 #1A6B3A
    rectangle "**timestamp**\nISO-8601\nUTC" as F5 #1A6B3A
}

F1 -right-> F2
F2 -right-> F3
F3 -right-> F4
F4 -right-> F5

' ── Notes sécurité ───────────────────────────────────────────────────
note bottom of MIC
  <b>AES-128 CMAC</b> (RFC 4493)
  ─────────────────────────
  Clé : <b>NwkSKey</b> (Network Session Key)
  Calculé sur : MHDR + FHDR + FPort + FRMPayload
  Résultat 16B tronqué à <b>4B</b>
  P(collision) = 2⁻³² ≈ 2,3×10⁻¹⁰
  → Rejet si MIC ≠ MIC recalculé
end note

note bottom of FRMPAY
  <b>AES-128 CTR mode</b>
  ──────────────────
  Clé : <b>AppSKey</b> (App Session Key)
  IV : DevAddr + FCnt + direction
  → Confidentialité payload capteur
  → Déchiffré uniquement par App Server
end note

note bottom of FCNT
  <b>Anti-rejeu</b>
  ────────────
  Paquet rejeté si
  FCnt ≤ FCnt_last
  Vulnérabilité ABP :
  reset nœud → FCnt=0
  → préférer OTAA
end note

@enduml
