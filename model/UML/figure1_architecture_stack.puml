@startuml
!theme plain
skinparam backgroundColor #FAFBFC
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #1B3A5C
skinparam ArrowThickness 2.5
skinparam ArrowFontColor #4A4A4A
skinparam ArrowFontSize 10

' ── Styles composants ────────────────────────────────────────────────
skinparam component {
    BackgroundColor #1B3A5C
    FontColor #FFFFFF
    BorderColor #D4A017
    BorderThickness 2.5
    RoundCorner 14
    FontStyle bold
    FontSize 12
}

skinparam database {
    BackgroundColor #0F2640
    FontColor #FFFFFF
    BorderColor #D4A017
    BorderThickness 2.5
    FontStyle bold
    FontSize 12
}

skinparam note {
    BackgroundColor #FFF8E7
    BorderColor #D4A017
    BorderThickness 1.5
    FontColor #4A4A4A
    FontSize 10
    RoundCorner 8
}

skinparam rectangle {
    BackgroundColor #EEF2F7
    FontColor #1B3A5C
    BorderColor #1B3A5C
    BorderThickness 2
    RoundCorner 16
}

' ── Titre ────────────────────────────────────────────────────────────
title
<color:#1B3A5C><size:18><b>  🐝  Jumeau Numérique — Architecture Stack Docker</b></size></color>
<color:#4A4A4A><size:11><i>Projet ETRS012 · Université Savoie Mont Blanc · Avril 2026</i></size></color>
end title

' ── Cadre principal ──────────────────────────────────────────────────
rectangle "  <b><color:#1B3A5C>docker compose up -d</color></b>  " as dock {

    ' ─── Production ─────────────────────────────────────────────────
    component "  📡  <b>random_data_publisher.py</b>\n\n  <i>Modèle Biophysique BEEHAVE-like</i>\n  Thermorégulation · Cycle de butinage\n  Simulation PDR LoRaWAN\n  SCENARIO : normal | extreme  " as PUB #1B3A5C

    component "  📨  <b>Mosquitto 2.x</b>\n\n  <i>Broker MQTT — Port :1883</i>\n  QoS 0 · Topic hive/ruche-01/telemetry  " as MQTT #1B3A5C

    component "  🔄  <b>mqtt_to_influx.py</b>\n\n  <i>Subscriber MQTT → InfluxDB</i>\n  Parsing JSON · Écriture time-series  " as BRIDGE #1B3A5C

    ' ─── Stockage & Viz ──────────────────────────────────────────────
    database "  🗄️  <b>InfluxDB 2.7</b>\n\n  Time-Series Database\n  Port :8086 · Bucket : hive\n  Requêtes Flux  " as INFLUX

    component "  📊  <b>Grafana</b>\n\n  <i>Dashboard temps réel</i>\n  Port :3000\n  Source : InfluxDB (Flux)  " as GRAFANA #2E6DA4

    ' ─── Analyse ─────────────────────────────────────────────────────
    component "  💾  <b>export_csv.py</b>\n\n  <i>Export InfluxDB → CSV</i>\n  data/processed/hive_timeseries.csv  " as EXPORT #2E6DA4

    component "  🧠  <b>train_eval.py</b>\n\n  <i>Algorithme de détection</i>\n  Interpolation linéaire gaps PDR\n  Dérivée de masse · Seuil −0,03 kg/min\n  Métriques : MAE · RMSE · F1  " as TRAIN #1B3A5C

}

' ── Flux de données ───────────────────────────────────────────────────
PUB    -down->  MQTT    : <b>JSON/MQTT</b>\npublish
MQTT   -down->  BRIDGE  : <b>subscribe</b>
BRIDGE -down->  INFLUX  : <b>write points</b>
INFLUX -right-> GRAFANA : <b>Flux query</b>\ntemps réel
INFLUX -down->  EXPORT  : <b>Flux query</b>\nexport
EXPORT -down->  TRAIN   : <b>CSV</b>\nhive_timeseries.csv

' ── Notes ─────────────────────────────────────────────────────────────
note right of PUB
  <b>Paramètres configurables</b>
  ────────────────────────
  LORAWAN_PDR  →  0,90 (H1) | 0,65 (H2)
  SCENARIO     →  normal | extreme
  PUBLISH_INTERVAL  →  5 s | 60 s
  MASS_FLOOR   →  5,0 kg (plancher physique)
end note

note right of TRAIN
  <b>Résultats expérimentaux</b>
  ─────────────────────────
  🌡  MAE thermique  =  0,635 °C
  ✅  H1 — F1-Score  =  1,00  (PDR 0,90)
  ⚠️  H2 — Rappel    =  0,94  (PDR 0,65)
  → 1 Faux Négatif à la transition
end note

note bottom of INFLUX
  <b>Dataset H1</b> · 5 216 points · ~8 h
  87 % nominal · 13 % extrême (essaimage)
  ~521 points interpolés (gaps PDR)
end note

' ── Légende ───────────────────────────────────────────────────────────
legend bottom
  |= Couleur |= Rôle |
  | <back:#1B3A5C>    </back> | Composants IoT / traitement |
  | <back:#2E6DA4>    </back> | Visualisation / Export |
  | <back:#0F2640>    </back> | Stockage time-series |
  | <back:#FFF8E7>    </back> | Paramètres & résultats |
endlegend

@enduml
