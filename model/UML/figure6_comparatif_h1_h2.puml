@startuml
!theme plain
skinparam backgroundColor #FAFBFC
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false

skinparam rectangle {
    RoundCorner 10
    BorderThickness 2
}

skinparam note {
    BackgroundColor #FFF8E7
    BorderColor #D4A017
    BorderThickness 1.5
    FontColor #4A4A4A
    RoundCorner 8
    FontSize 10
}

title
<color:#1B3A5C><size:16><b>Figure 6 — Comparaison des performances H1 vs H2</b></size></color>
<color:#4A4A4A><size:10><i>Précision · Rappel · F1-Score selon le PDR LoRaWAN · Seuil −0,03 kg/min</i></size></color>
end title

' ── Matrice de confusion H1 ───────────────────────────────────────────
package "📊  Dataset H1 — PDR = 0,90 · τ_pub = 5 s" as H1PKG #EEF2F7 {

    rectangle "**H1 — Matrice de confusion**\n\n\
<back:#D5E8D4><color:#27AE60>  TP = 3 192  </color></back>  <back:#F8CECC><color:#E74C3C>  FP = 0  </color></back>\n\
<back:#F8CECC><color:#E74C3C>  FN = 0  </color></back>  <back:#DAE8FC>  TN ≈ 1 503  </back>\n\n\
Précision  =  <b>1,00</b>  ████████████ 100 %\n\
Rappel     =  <b>1,00</b>  ████████████ 100 %\n\
F1-Score   =  <b>1,00</b>  ████████████ 100 %" as H1MAT #FFFFFF

}

note right of H1PKG
  <b>Baseline de référence</b>
  ─────────────────────────────
  ⚠ Résultat <b>attendu par construction</b>
  Facteur séparation classes : ×14
  (−0,003 vs −0,042 kg/min)
  Ground truth : plage horaire 13h30–14h30
  → Biais partiel (dataset antérieur au tag)
  ─────────────────────────────
  Signification : pipeline fonctionne
  sans contrainte réseau sévère
end note

' ── Matrice de confusion H2 ───────────────────────────────────────────
package "📊  Dataset H2 — PDR = 0,65 · τ_pub = 60 s" as H2PKG #EEF2F7 {

    rectangle "**H2 — Matrice de confusion**\n\n\
<back:#D5E8D4><color:#27AE60>  TP = 17  </color></back>  <back:#F8CECC><color:#E74C3C>  FP = 0  </color></back>\n\
<back:#F8CECC><color:#E74C3C>  FN = 1  </color></back>  <back:#DAE8FC>  TN = ?  </back>\n\n\
Précision  =  <b>1,00</b>  ████████████ 100 %\n\
Rappel     =  <b>0,94</b>  ███████████░  94 %\n\
F1-Score   =  <b>0,97</b>  ███████████░  97 %" as H2MAT #FFFFFF

}

note right of H2PKG
  <b>Contribution scientifique principale</b>
  ────────────────────────────────────
  ✅ Ground truth : tag <b>scenario</b> InfluxDB
     (méthode rigoureuse, sans biais)
  ────────────────────────────────────
  <b>Mécanisme du FN unique :</b>
  Gap 60 s à la transition → interpolation
  lisse la chute de masse →
  dM/dt_lissé ≈ −0,021 < seuil −0,030
  → 1 essaimage manqué sur la frontière
  ────────────────────────────────────
  Tous les paquets suivants détectés
  (dM/dt ≈ −0,042 >> seuil)
end note

